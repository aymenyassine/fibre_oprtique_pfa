  "destinataire": "client@test.com",
  "sujet": "Maintenance planifiée",
  "contenu": "Bonjour, une maintenance est prévue le 20 juin de 2h à 4h du matin. Nous vous prions de nous excuser pour la gêne occasionnée.",
  "typeCanal": "EMAIL"
}

