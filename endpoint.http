  "debitDescendant": 1000,
  "prixHT": 34.90,
  "tauxTVA": 20.00,
  "typeEngagement": "DOUZE_MOIS",
  "dureeMois": 12,
  "technologie": "FTTH",
  "actif": true
}

###

